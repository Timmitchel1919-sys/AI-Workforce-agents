{
  "name": "ai-workforce-agents",
  "version": "0.1.0",
  "description": "AI Workforce foundation: deterministic orchestration, deny-by-default permissions, human approval gates, and provider-agnostic adapters.",
  "private": true,
  "type": "module",
  "main": "dist/functions/index.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "functions:build": "npm run build",
    "functions:manifest": "node scripts/generate-functions-manifest.mjs",
    "functions:prepare": "npm run functions:build && npm run functions:manifest",
    "admin:bootstrap": "npm run build && node scripts/bootstrap-initial-admin.mjs",
    "functions:test": "npm run build && node --test dist/tests/firebase-function-adapter.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1",
    "firebase-admin": ">=13 <15"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "openai": "^6.17.0"
  }
}
