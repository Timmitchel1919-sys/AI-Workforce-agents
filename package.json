{
  "name": "ai-workforce-agents",
  "version": "0.1.0",
  "description": "AI Workforce foundation: deterministic orchestration, deny-by-default permissions, human approval gates, and provider-agnostic adapters.",
  "private": true,
  "type": "module",
  "main": "dist/functions/index.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "functions:build": "npm run build",
    "functions:manifest": "node scripts/generate-functions-manifest.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "functions:prepare": "npm run functions:build && npm run functions:manifest",
    "admin:bootstrap": "npm run build && node scripts/bootstrap-initial-admin.mjs",
    "functions:test": "npm run build && node --test dist/tests/firebase-function-adapter.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:unit": "npm run build && node scripts/run-unit-tests.mjs",
    "test:firebase": "npm run build && node scripts/check-emulator-runtime.mjs && node scripts/run-firebase-emulator-suite.mjs",
    "test:firebase:inner": "node scripts/run-firebase-tests.mjs",
    "test:e2e:authenticated": "npm run build && node scripts/run-authenticated-e2e.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "staging:check": "node scripts/check-staging-config.mjs",
    "staging:deploy": "node scripts/deploy-staging.mjs",
    "staging:verify": "node scripts/verify-staging.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "security:deps": "node scripts/security-deps.mjs",
    "security:secrets": "node scripts/security-secrets.mjs",
    "security:sast": "npm run typecheck && npm run lint",
    "security:sbom": "node scripts/security-sbom.mjs",
    "security:license": "node scripts/security-license.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1",
    "firebase-admin": ">=13 <15"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "dependencies": {
    "firebase-admin": ">=13 <15",
    "firebase-functions": "^7.3.2",
    "framer-motion": "^14.3.0",
    "openai": "^6.17.0"
  }
}
