rules_version = '2';

// AI Workforce — Firestore security rules.
//
// The Control Plane (Firebase Admin SDK, server-side) is the ONLY reader and
// writer of this database. Admin-SDK access bypasses these rules by design.
//
// No client may touch Firestore directly — not the Control Center UI, not any
// future external client. Every UI read and write goes through the Control
// Plane HTTP API, which enforces authentication, authorization, approval,
// project isolation, and audit. This deny-all rule makes that boundary
// impossible to bypass from a browser.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
