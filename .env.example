# AI Workforce — environment configuration example.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# These values are read only by adapters (e.g. the Anthropic model provider),
# never by the Workforce core.

# --- Anthropic model provider ---------------------------------------------
# Required: your Anthropic API key. Placeholder only — replace locally.
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-KEY

# Optional: model identifier (defaults to claude-3-5-sonnet-latest).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: request timeout in milliseconds (default 60000).
# ANTHROPIC_TIMEOUT_MS=60000

# Optional: maximum output tokens per request (default 1024).
# ANTHROPIC_MAX_TOKENS=1024

# Optional: SDK retry attempts for transient failures (default 2).
# ANTHROPIC_MAX_RETRIES=2

# --- Firebase infrastructure (Phase 7B) ---------------------------------
# Read by the Control Plane API composition root; never by the Workforce core.

# Required: Firebase / GCP project id.
FIREBASE_PROJECT_ID=ai-workforce-agents

# Required in production: absolute path to a service-account JSON key.
# NEVER commit the key file (it is gitignored by *service-account*.json).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: storage bucket (default: <projectId>.appspot.com).
# FIREBASE_STORAGE_BUCKET=ai-workforce-agents.appspot.com

# Local emulator — set these to run against `firebase emulators:start`
# (no credentials needed when emulated):
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
