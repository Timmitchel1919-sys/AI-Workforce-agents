# Deployed (vite build, mode=production) API configuration — DEPLOY-1C.
# The UI is served by Firebase Hosting; firebase.json rewrites /api/** to the
# controlPlaneApi HTTPS Function. Requests stay same-origin, so the API base
# stays empty and the Control Plane routes resolve through the rewrite.
VITE_API_BASE_URL=

# Control Plane HTTP API routes (api/http-api.ts, basePath "/api")
VITE_AGENTS_PATH=/api/agents
VITE_TASKS_PATH=/api/tasks
VITE_WORKFLOWS_PATH=/api/workflows
VITE_OVERVIEW_PATH=/api/dashboard

# Fill in your Firebase web app credentials (public, client-safe) so browser
# sign-in can mint ID tokens for the Control Plane API.
VITE_FIREBASE_API_KEY=AIzaSyANKEjCayDgAE67LAOUI-m-xJSI2BeJb3A
VITE_FIREBASE_AUTH_DOMAIN=ai-workforce-agents.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-workforce-agents
VITE_FIREBASE_APP_ID=1:133819191195:web:35581d59989b6a97655b3e

