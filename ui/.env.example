# AI Workforce Control Center — frontend environment.
# Copy to `.env.local` (gitignored) and fill in real values.
#
# EVERY `VITE_*` variable is embedded in the browser bundle. Put ONLY
# public, non-sensitive values here. NEVER add:
#   - a Firebase Admin private key / service-account JSON
#   - GOOGLE_APPLICATION_CREDENTIALS
#   - the Anthropic / OpenAI API key
#   - GitHub tokens or database credentials
# Those belong to the server-side Control Plane only (repo-root `.env`).

# --- Control Plane HTTP API --------------------------------------------------
# Base URL of the Control Plane API. In dev, leave as "/api" and let Vite proxy
# it (VITE_API_PROXY_TARGET below). In production, an absolute https URL.
VITE_API_BASE_URL=/api

# Dev-only: where `vite` proxies `/api` to (a locally running Control Plane API).
VITE_API_PROXY_TARGET=http://localhost:8787

# --- Firebase Authentication (client SDK — public config) ------------------
# From the Firebase console → Project settings → "Your apps" → SDK setup.
# The Firebase project is the existing one: ai-workforce-agents.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=ai-workforce-agents.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-workforce-agents
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
VITE_FIREBASE_STORAGE_BUCKET=ai-workforce-agents.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID

# Local Auth emulator (optional). Matches firebase.json (auth port 9099).
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
