# Control Plane API base. Empty = same request origin.
# Production (DEPLOY-1C): leave empty — Firebase Hosting rewrites /api/** to
# the controlPlaneApi function, so API requests stay same-origin:
#   VITE_API_BASE_URL=
# Alternative: point directly at a Control Plane API origin (e.g. an emulator
# or local loopback server) by setting this to its URL. The Control Plane
# routes below are appended to it.
VITE_API_BASE_URL=

# Control Plane HTTP API routes (api/http-api.ts, basePath "/api")
VITE_AGENTS_PATH=/api/agents
VITE_TASKS_PATH=/api/tasks
VITE_WORKFLOWS_PATH=/api/workflows
VITE_OVERVIEW_PATH=/api/dashboard

# Firebase web app credentials (public — client-safe, required for browser
# sign-in to mint ID tokens for the Control Plane API)
VITE_FIREBASE_API_KEY=AIzaSyANKEjCayDgAE67LAOUI-m-xJSI2BeJb3A
VITE_FIREBASE_AUTH_DOMAIN=ai-workforce-agents.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-workforce-agents
VITE_FIREBASE_STORAGE_BUCKET=ai-workforce-agents.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=133819191195
VITE_FIREBASE_APP_ID=1:133819191195:web:35581d59989b6a97655b3e
